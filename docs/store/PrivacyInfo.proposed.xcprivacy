<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PROPOSAL ONLY. Not placed in mobile/ios. Target path when adopted:
  mobile/ios/App/App/PrivacyInfo.xcprivacy, added to the App target's
  "Copy Bundle Resources" (Xcode: File > Add Files, tick the App target).
  See docs/store/PRIVACY-LABELS.md section "Privacy manifest" for rationale.
  Key names are from Apple's documented schema as recalled; Apple's doc pages
  returned no body when fetched, so VERIFY against Xcode's plist editor
  (Xcode shows a typed editor for .xcprivacy) before shipping.
-->
<plist version="1.0">
<dict>
	<!-- We do no cross-app tracking and use no ad or attribution SDK. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Must match the App Store Connect App Privacy answers exactly. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- ADD ONLY WHEN PHASE 12 SHIPS (Kumaun Full, entitlement stored per user):
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		-->
	</array>

	<!--
	  Required-reason APIs. Evidence from the repo (2026-10-11): our own App target
	  (AppDelegate.swift, SceneDelegate.swift) and the installed Capacitor 8.5.3 plugin
	  Swift sources contain NO use of UserDefaults, file timestamp, boot time, disk space
	  or active keyboard APIs, and @capacitor/ios ships its own manifest with an empty
	  array. So the proposal is an empty array.
	  If the Xcode archive's Privacy Report or an ITMS-91053 email names a category
	  (most likely a Swift Package dependency such as OSBarcodeLib-iOS, which is not
	  in node_modules and could NOT be inspected), add only that category, e.g.:
	    NSPrivacyAccessedAPIType = NSPrivacyAccessedAPICategoryUserDefaults
	    NSPrivacyAccessedAPITypeReasons = [CA92.1]   (app reads data it wrote itself)
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
