# NEXT_PUBLIC_API_URL is inlined into the bundle at BUILD time.
# In Vercel, set it for both Production and Preview to the Railway API origin
# with no trailing slash (e.g. https://kitcha-api-production.up.railway.app).
# Production builds will fail without it (enforced in a later plan).
# NEXT_PUBLIC values are public; never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public support address shown on /support and in the legal pages (inlined at build time).
# Leave empty locally; set it in Vercel before store submission.
# Production builds log a non-fatal [store-readiness] warning while this is missing.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional override for the AI provider name shown in the privacy policy and consent sheet.
# NEXT_PUBLIC_AI_PROVIDER_LABEL=
