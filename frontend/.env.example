# NEXT_PUBLIC_API_URL is inlined into the bundle at BUILD time.
# In Vercel, set it for both Production and Preview to the Railway API origin
# with no trailing slash (e.g. https://kitcha-api-production.up.railway.app).
# Production builds will fail without it (enforced in a later plan).
# NEXT_PUBLIC values are public; never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3001
