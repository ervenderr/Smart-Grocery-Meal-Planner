# Server
# Runtime environment: development | test | production
NODE_ENV=development
# Local only. Never set on Railway (the platform injects PORT).
PORT=3001

# Postgres connection string (postgres:// or postgresql://). On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://username:password@localhost:5432/smart_grocery_db?schema=public"

# JWT signing secret, min 32 chars, must not look like a default value
# generate: openssl rand -hex 32
JWT_SECRET=
# Token lifetime (default 7d)
JWT_EXPIRES_IN=7d

# API path version prefix (default v1)
API_VERSION=v1

# Log level (default info)
LOG_LEVEL=debug

# Allowed browser origins, comma separated, no trailing slash. Prod: https://kitcha-ai.vercel.app
CORS_ORIGIN=http://localhost:3000
# Extra frontend origin merged into the allowlist
# FRONTEND_URL=https://kitcha-ai.vercel.app
# Vercel team/user scope used to allow this project's preview URLs
VERCEL_PREVIEW_SCOPE=ervenderrs-projects
# Vercel project name used for preview URLs (default kitcha)
VERCEL_PREVIEW_PROJECT=kitcha

# AI provider: one OpenAI-compatible endpoint. Defaults point to Dahl Inference.
# AI_PROVIDER=dahl
# AI_BASE_URL=https://inference.dahl.global/v1
# AI_MODEL=MiniMaxAI/MiniMax-M2.7
# Server-side secret. Leave empty to disable AI (the API still starts, /health stays green).
AI_API_KEY=
# Per-call timeout in ms (default 40000)
# AI_TIMEOUT_MS=40000
# Max completion tokens (default 8000; reasoning models emit a think block first)
# AI_MAX_TOKENS=8000
# off | json_object (opt-in response_format, default off)
# AI_JSON_MODE=off
# Daily request caps, UTC day (defaults 20 per user, 100 global)
# AI_USER_DAILY_LIMIT=20
# AI_GLOBAL_DAILY_LIMIT=100
# Optional: USDA FoodData Central key (free from api.data.gov)
USDA_API_KEY=
# Contact (URL or email) put in the Open Food Facts User-Agent
# OFF_CONTACT=https://github.com/ervenderr/Smart-Grocery-Meal-Planner
# Optional: Spoonacular API key
# SPOONACULAR_API_KEY=
# Optional: Zapier webhook URL
# ZAPIER_WEBHOOK_URL=

# Canonical public host for the production HTTP->HTTPS redirect (optional).
# Falls back to RAILWAY_PUBLIC_DOMAIN, which Railway injects automatically.
# PUBLIC_HOST=api.example.com
